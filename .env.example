# The Journey environment variables
# Copy to .env.local for local development when a future integration needs them.
# Never put real credentials in this file.

# Public / browser-safe / runtime
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only / runtime
# SUPABASE_SERVICE_ROLE_KEY=

# Data refresh / maintenance (server or CI only)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_MAX_ITEMS=5000
